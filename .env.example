# Platina AI OS — environment template. Copy to .env.local and fill in.
# NEVER put real values in this file — it is committed to git.
# Every variable here is actually read by the code (audited 2026-07-13).

# --- Database (Supabase Postgres, transaction-mode pooler) ---
# Supabase → Settings → Database → "Transaction" pooler string.
# The client uses prepare:false to match transaction mode.
DATABASE_URL=postgresql://user:password@your-region.pooler.supabase.com:6543/postgres

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → Credentials → OAuth client ID (type Web).
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (magic-link login) — https://resend.com/api-keys
AUTH_RESEND_KEY=
RESEND_API_KEY=
EMAIL_FROM="Platina AI OS <login@yourdomain.com>"
# Dev-only sign-in bypass (src/auth.ts). NEVER set this to "true" in any
# production environment — it bypasses real authentication and signs in as
# a single fixed dev@localhost.test identity. Exists only for local
# development/testing; also requires NODE_ENV !== "production" to activate.
AUTH_DEV_BYPASS=

# --- AI providers (router: Groq fast tier, Gemini embeddings + fallback) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional override for the quality-tier Gemini model
GEMINI_QUALITY_MODEL=gemini-3.1-pro-preview
# Optional daily AI spend cap in USD
AI_DAILY_COST_CAP_USD=5

# --- AWS Bedrock (optional quality tier; falls back to Groq when unset) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# --- Connectors ---
# NOTE: the code reads APIFY_TOKEN — a bare token, not a URL.
APIFY_TOKEN=
# Optional: override individual actors in the multi-actor registry.
# Defaults live in src/lib/connectors/apify-actors.ts — leave blank to use them.
APIFY_ACTOR_POSTS=
APIFY_ACTOR_REELS=
APIFY_ACTOR_PROFILE=
APIFY_ACTOR_COMMENTS=
APIFY_ACTOR_DEEP_POST=
APIFY_ACTOR_TIKTOK_POSTS=
APIFY_ACTOR_TIKTOK_PROFILE=
APIFY_ACTOR_AD_LIBRARY=
# Flip to "true" only after Meta app review clears (constitution: feature flag)
META_CONNECTOR_ENABLED=false

# --- Background jobs (Inngest) ---
INNGEST_DEV=1

# --- Supabase client (hub realtime; publishable key is public by design) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Supabase dashboard → Settings → API → service_role.
# Never prefix this NEXT_PUBLIC_ — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. HMAC key for Platina's opaque Realtime topic tokens (platina:<token>:live).
# Absence degrades Platina live updates to the 20s polling fallback � never expose this.
PLATINA_REALTIME_SECRET=
